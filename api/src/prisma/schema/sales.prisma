// ---------- Shifts ----------

enum ShiftStatus {
  OPEN
  CLOSED

  @@map("shift_status")
}

// A cashier's session at a counter. One OPEN shift per user and branch (enforced in ShiftService).
model Shift {
  id          String      @id @default(uuid()) @db.Uuid
  branchId    String      @map("branch_id") @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  counter     String      @db.VarChar(30)
  status      ShiftStatus @default(OPEN)
  openingCash Decimal     @default(0) @map("opening_cash") @db.Decimal(12, 2)
  openedAt    DateTime    @default(now()) @map("opened_at") @db.Timestamptz(3)
  closedAt    DateTime?   @map("closed_at") @db.Timestamptz(3)
  // { CASH: "1200.00", UPI: "…" } as counted and as expected from the payments at close.
  counted     Json?
  expected    Json?
  closeNote   String?     @map("close_note") @db.VarChar(300)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch   Branch    @relation(fields: [branchId], references: [id])
  invoices Invoice[]
  payments Payment[]

  @@index([branchId, userId, status])
  @@index([openedAt])
  @@map("shifts")
}

// A parked POS cart (F8). `payload` is the validated heldCartCreateSchema body.
model HeldCart {
  id         String    @id @default(uuid()) @db.Uuid
  branchId   String    @map("branch_id") @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  label      String?   @db.VarChar(60)
  customerId String?   @map("customer_id") @db.Uuid
  payload    Json
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(3)

  @@index([branchId, deletedAt])
  @@map("held_carts")
}

// ---------- Invoices ----------

// Stored status; OVERDUE is derived when reading (unpaid past due date).
// SALE = a tax invoice from the POS. OPENING_BALANCE = a customer's old dues entered at go-live:
// no lines, no tax, no stock; it counts in dues and collections but never in sales, GST or Tally sales.
enum InvoiceKind {
  SALE
  OPENING_BALANCE

  @@map("invoice_kind")
}

enum InvoiceStatus {
  PAID
  PARTIALLY_PAID
  UNPAID
  CANCELLED

  @@map("invoice_status")
}

enum SupplyType {
  INTRA_STATE
  INTER_STATE

  @@map("supply_type")
}

enum InvoiceLineKind {
  ITEM
  LABOUR

  @@map("invoice_line_kind")
}

// A posted tax invoice. Never edited after posting: corrections are a cancellation or a credit note.
// Customer details are copied at posting so the printed invoice never changes.
model Invoice {
  id                   String        @id @default(uuid()) @db.Uuid
  number               String        @db.VarChar(30)
  kind                 InvoiceKind   @default(SALE)
  branchId             String        @map("branch_id") @db.Uuid
  shiftId              String?       @map("shift_id") @db.Uuid
  customerId           String?       @map("customer_id") @db.Uuid
  customerName         String?       @map("customer_name") @db.VarChar(150)
  customerMobile       String?       @map("customer_mobile") @db.VarChar(10)
  customerGstin        String?       @map("customer_gstin") @db.VarChar(15)
  customerAddress      String?       @map("customer_address") @db.VarChar(400)
  placeOfSupply        String        @map("place_of_supply") @db.VarChar(2)
  supplyType           SupplyType    @map("supply_type")
  invoiceDate          DateTime      @default(now()) @map("invoice_date") @db.Timestamptz(3)
  dueDate              DateTime?     @map("due_date") @db.Timestamptz(3)
  status               InvoiceStatus
  grossTotal           Decimal       @map("gross_total") @db.Decimal(12, 2)
  discountTotal        Decimal       @map("discount_total") @db.Decimal(12, 2)
  billDiscountType     String?       @map("bill_discount_type") @db.VarChar(10)
  billDiscountValue    Decimal?      @map("bill_discount_value") @db.Decimal(12, 2)
  taxableTotal         Decimal       @map("taxable_total") @db.Decimal(12, 2)
  cgstTotal            Decimal       @map("cgst_total") @db.Decimal(12, 2)
  sgstTotal            Decimal       @map("sgst_total") @db.Decimal(12, 2)
  igstTotal            Decimal       @map("igst_total") @db.Decimal(12, 2)
  roundOff             Decimal       @map("round_off") @db.Decimal(12, 2)
  grandTotal           Decimal       @map("grand_total") @db.Decimal(12, 2)
  // Net of reversals and refunds.
  paidTotal            Decimal       @default(0) @map("paid_total") @db.Decimal(12, 2)
  creditedTotal        Decimal       @default(0) @map("credited_total") @db.Decimal(12, 2)
  notes                String?       @db.VarChar(300)
  discountApprovedById String?       @map("discount_approved_by_id") @db.Uuid
  creditApprovedById   String?       @map("credit_approved_by_id") @db.Uuid
  createdById          String?       @map("created_by_id") @db.Uuid
  cancelledAt          DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledById        String?       @map("cancelled_by_id") @db.Uuid
  cancelReason         String?       @map("cancel_reason") @db.VarChar(200)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  branch      Branch        @relation(fields: [branchId], references: [id])
  shift       Shift?        @relation(fields: [shiftId], references: [id])
  customer    Customer?     @relation(fields: [customerId], references: [id])
  lines       InvoiceLine[]
  payments    Payment[]
  creditNotes CreditNote[]

  @@unique([branchId, number])
  @@index([branchId, invoiceDate])
  @@index([customerId])
  @@index([status])
  @@index([shiftId])
  @@map("invoices")
}

model InvoiceLine {
  id              String          @id @default(uuid()) @db.Uuid
  invoiceId       String          @map("invoice_id") @db.Uuid
  lineNo          Int             @map("line_no")
  kind            InvoiceLineKind
  itemId          String?         @map("item_id") @db.Uuid
  labourServiceId String?         @map("labour_service_id") @db.Uuid
  description     String          @db.VarChar(200)
  sku             String?         @db.VarChar(40)
  hsnSac          String?         @map("hsn_sac") @db.VarChar(8)
  unit            String          @db.VarChar(10)
  quantity        Decimal         @db.Decimal(12, 3)
  rate            Decimal         @db.Decimal(12, 2)
  taxInclusive    Boolean         @default(false) @map("tax_inclusive")
  gstRate         Decimal         @map("gst_rate") @db.Decimal(5, 2)
  lineDiscount    Decimal         @default(0) @map("line_discount") @db.Decimal(12, 2)
  billDiscount    Decimal         @default(0) @map("bill_discount") @db.Decimal(12, 2)
  taxable         Decimal         @db.Decimal(12, 2)
  cgst            Decimal         @db.Decimal(12, 2)
  sgst            Decimal         @db.Decimal(12, 2)
  igst            Decimal         @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  unitCost        Decimal?        @map("unit_cost") @db.Decimal(12, 2)
  // Quantity already returned through credit notes.
  returnedQty     Decimal         @default(0) @map("returned_qty") @db.Decimal(12, 3)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([itemId])
  @@map("invoice_lines")
}

// Append-only. A wrong payment is reversed by a negative row pointing at it; refunds are negative rows too.
model Payment {
  id                String   @id @default(uuid()) @db.Uuid
  invoiceId         String   @map("invoice_id") @db.Uuid
  branchId          String   @map("branch_id") @db.Uuid
  shiftId           String?  @map("shift_id") @db.Uuid
  mode              String   @db.VarChar(20)
  amount            Decimal  @db.Decimal(12, 2)
  tendered          Decimal? @db.Decimal(12, 2)
  reference         String?  @db.VarChar(60)
  note              String?  @db.VarChar(200)
  // REVERSAL (undoing a payment), REFUND (money back on cancel/credit note) or null for a receipt.
  kind              String?  @db.VarChar(10)
  reversesPaymentId String?  @unique @map("reverses_payment_id") @db.Uuid
  creditNoteId      String?  @map("credit_note_id") @db.Uuid
  createdById       String?  @map("created_by_id") @db.Uuid
  receivedAt        DateTime @default(now()) @map("received_at") @db.Timestamptz(3)

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  @@index([invoiceId])
  @@index([shiftId])
  @@index([branchId, receivedAt])
  @@map("payments")
}

model CreditNote {
  id           String   @id @default(uuid()) @db.Uuid
  number       String   @db.VarChar(30)
  branchId     String   @map("branch_id") @db.Uuid
  invoiceId    String   @map("invoice_id") @db.Uuid
  reason       String   @db.VarChar(200)
  taxableTotal Decimal  @map("taxable_total") @db.Decimal(12, 2)
  cgstTotal    Decimal  @map("cgst_total") @db.Decimal(12, 2)
  sgstTotal    Decimal  @map("sgst_total") @db.Decimal(12, 2)
  igstTotal    Decimal  @map("igst_total") @db.Decimal(12, 2)
  roundOff     Decimal  @map("round_off") @db.Decimal(12, 2)
  total        Decimal  @db.Decimal(12, 2)
  refunded     Decimal  @default(0) @db.Decimal(12, 2)
  createdById  String?  @map("created_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  invoice Invoice          @relation(fields: [invoiceId], references: [id])
  lines   CreditNoteLine[]

  @@unique([branchId, number])
  @@index([invoiceId])
  @@index([branchId, createdAt])
  @@map("credit_notes")
}

model CreditNoteLine {
  id            String  @id @default(uuid()) @db.Uuid
  creditNoteId  String  @map("credit_note_id") @db.Uuid
  invoiceLineId String  @map("invoice_line_id") @db.Uuid
  quantity      Decimal @db.Decimal(12, 3)
  taxable       Decimal @db.Decimal(12, 2)
  cgst          Decimal @db.Decimal(12, 2)
  sgst          Decimal @db.Decimal(12, 2)
  igst          Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
  @@index([invoiceLineId])
  @@map("credit_note_lines")
}

// ---------- Reliability ----------

// First response to a POST with an Idempotency-Key, replayed on retries (double F12, flaky network).
model IdempotencyKey {
  userId      String   @map("user_id") @db.Uuid
  key         String   @db.VarChar(100)
  scope       String   @db.VarChar(30)
  requestHash String   @map("request_hash") @db.VarChar(64)
  resourceId  String   @map("resource_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@id([userId, key])
  @@map("idempotency_keys")
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED

  @@map("outbox_status")
}

// Side effects for the Phase 7 worker (WhatsApp, e-invoice…), written in the same transaction as the change.
model OutboxEvent {
  id          String       @id @default(uuid()) @db.Uuid
  type        String       @db.VarChar(40)
  payload     Json
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  lastError   String?      @map("last_error") @db.VarChar(500)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@map("outbox_events")
}

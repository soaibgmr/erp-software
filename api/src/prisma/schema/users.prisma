enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED

  @@map("user_status")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  businessId      String     @map("business_id") @db.Uuid
  firstName       String     @map("first_name") @db.VarChar(100)
  lastName        String     @map("last_name") @db.VarChar(100)
  // Login is by mobile (or email). Both unique across the whole product: one person, one company.
  mobile          String?    @unique @db.VarChar(10)
  email           String?    @unique @db.VarChar(255)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  passwordHash    String     @map("password_hash") @db.VarChar(255)
  phone           String?    @db.VarChar(30)
  roleId          String     @map("role_id") @db.Uuid
  status          UserStatus @default(ACTIVE)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  // Soft delete: rows are never hard-deleted.
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  role          Role           @relation(fields: [roleId], references: [id])
  branches      UserBranch[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]
  authTokens    AuthToken[]

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([roleId, status])
  @@index([createdAt])
  @@map("users")
}

// A role is a named set of permission codes (see packages/shared/src/permissions.ts).
// System roles carry a `key`; the OWNER role bypasses permission and branch checks.
model Role {
  id          String    @id @default(uuid()) @db.Uuid
  businessId  String    @map("business_id") @db.Uuid
  key         String?   @db.VarChar(30)
  name        String    @db.VarChar(60)
  description String?   @db.VarChar(200)
  permissions String[]  @db.VarChar(40)
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  users User[]

  business Business @relation(fields: [businessId], references: [id])

  @@unique([businessId, key])
  @@unique([businessId, name])
  @@map("roles")
}

// Branches a user may work in. Owners have access to every branch regardless.
model UserBranch {
  userId    String   @map("user_id") @db.Uuid
  branchId  String   @map("branch_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@id([userId, branchId])
  @@index([branchId])
  @@map("user_branches")
}

// Opaque refresh tokens; only the SHA-256 hash is stored. Revoked rows are kept so reuse can be detected.
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

enum AuthTokenPurpose {
  RESET_PASSWORD
  VERIFY_EMAIL

  @@map("auth_token_purpose")
}

// One-time tokens sent by email (password reset, email verification). Only the SHA-256 hash is stored.
model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  purpose   AuthTokenPurpose
  tokenHash String           @unique @map("token_hash") @db.VarChar(64)
  expiresAt DateTime         @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?        @map("used_at") @db.Timestamptz(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id])

  @@index([userId, purpose])
  @@map("auth_tokens")
}

// The product owner: approves, rejects and suspends registered shops. Never sees shop data.
model PlatformAdmin {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_admins")
}

// "Book a quick demo" requests from the public landing page, for the platform admin to call back.
model DemoRequest {
  id        String    @id @default(uuid()) @db.Uuid
  name      String?   @db.VarChar(100)
  mobile    String    @db.VarChar(10)
  email     String?   @db.VarChar(255)
  ip        String?   @db.VarChar(64)
  // Set when the platform admin marks the request as handled.
  handledAt DateTime? @map("handled_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt])
  @@map("demo_requests")
}

// Shared counters for rate limits and failed-sign-in lockouts. In the database, not memory, so every
// serverless instance sees the same count. Rows are tiny and expired ones are cleaned up as they are touched.
model RateLimit {
  key     String   @id @db.VarChar(255)
  count   Int
  resetAt DateTime @map("reset_at") @db.Timestamptz(3)

  @@index([resetAt])
  @@map("rate_limits")
}

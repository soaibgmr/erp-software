{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": { "deploymentEnabled": false },
  "installCommand": "cd .. && npm ci --include=dev",
  "buildCommand": "cd .. && npm run build:shared && npm run build -w @erp-software/api && npm run bundle -w @erp-software/api",
  "outputDirectory": "public",
  "regions": [
    "syd1"
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{dist/bundle,certs}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ]
}

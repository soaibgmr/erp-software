# Copy to .env.local for your machine (local PostgreSQL) and to .env for live (Supabase).
# .env.local wins locally; the server has no .env.local, so it uses .env. Both are git-ignored.
NODE_ENV=development
PORT=8000

# Runtime connection used by the app. In production this can point at a pooler
# (e.g. PgBouncer in transaction mode); keep sslmode=require for remote hosts.
DATABASE_URL="postgresql://postgres:[YOUR_PASSWORD]@localhost:5432/[DATABASE_NAME]?schema=public"
# Direct (non-pooled) connection used by the Prisma CLI for migrations.
DIRECT_URL="postgresql://postgres:[YOUR_PASSWORD]@localhost:5432/[DATABASE_NAME]?schema=public"

# On Vercel (serverless, many short-lived instances) use the Supabase transaction pooler (port 6543)
# for DATABASE_URL and keep DB_POOL_MAX small (2). A relative sslrootcert (certs/supabase-ca.crt) is
# resolved against the api/ folder, so it works locally and on Vercel.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=15000

# At least 32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Required `clientid` header value for /api/v1 routes. Leave empty to skip the check (not allowed in production).
CLIENT_ID=

# Swagger UI at /docs (spec at /docs/openapi.json). Defaults to true outside production, false in production.
SWAGGER_ENABLED=

# IANA timezone of the app (e.g. Asia/Kolkata). Defaults to Asia/Kolkata. The UI reads it from GET /api/v1/health.
APP_TIMEZONE=Asia/Kolkata

# Browser origins allowed by CORS, comma-separated.
CORS_ORIGIN=http://localhost:5173
# pino log level: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Public URL of the UI (links in emails; falls back to the first CORS_ORIGIN) and the product name used in emails.
APP_URL=http://localhost:5173
APP_NAME=ERP Software

# Email over SMTP (Brevo, Zoho, Gmail app password, Amazon SES…). Leave SMTP_HOST empty to log emails instead
# of sending them (handy locally: the verify / reset links appear in the API console).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ERP Software <no-reply@example.com>"
# The platform admin's inbox for "new shop registered" notices.
PLATFORM_ADMIN_NOTIFY_EMAIL=


# Used only by `npm run db:seed`. Quote values containing # (otherwise everything after # is dropped as a comment).
# The platform admin approves shops at /admin (UI).
SEED_PLATFORM_ADMIN_EMAIL=admin@example.com
SEED_PLATFORM_ADMIN_PASSWORD=change-me-now
# Optional demo shop (created ACTIVE) with its owner. Leave SEED_ADMIN_EMAIL empty to skip it.
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_MOBILE=9876543210
SEED_ADMIN_PASSWORD=change-me-now

# Base URL of the API (no trailing slash)
VITE_API_URL=http://localhost:8000/api/v1
# Must equal CLIENT_ID in api/.env (sent as the `clientid` header)
VITE_CLIENT_ID=
# Sentry DSN for the browser app (optional). When set, screen crashes are reported there.
VITE_SENTRY_DSN=
# Product name shown on the landing page, sign-in and help (defaults to "ERP Software")
VITE_APP_NAME=
# Public contact email for the landing page's "Contact us" link (hidden when empty)
VITE_CONTACT_EMAIL=
